# Copy to .env (gitignored) and fill in. Never commit .env. Guide: docs/runbooks/local-setup.md
# The real environment wins over .env, so GitHub Actions secrets are not affected.
# Keep comments on their own lines: scout/llm.py's loader does not strip trailing comments.

# --- Needed to run the store pipeline locally ---
# Z.ai GLM Flash, free; first model for every task (scout/llm.py)
ZAI_API_KEY=
# OpenRouter free lane (900 calls a day cap) and the paid fallback
OPENROUTER_API_KEY=
# Private Supabase bucket "lake" that holds data/private (decision 0017)
SUPABASE_URL=
# The sb_secret_... key, not the publishable one
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=lake

# --- Needed for the CJ supply check (make stores-sanity, warehouse jobs) ---
CJ_API_KEY=

# --- Optional ---
# Sandbox keys only so far; production returns 401
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENV=sandbox
# Paid unblock tiers (decision 0015); empty means the tier is skipped
ZENROWS_API_KEY=
SCRAPINGBEE_API_KEY=

# --- Switches (defaults) ---
# 1 allows paid Claude routes via OpenRouter (owner approval)
SCOUT_ALLOW_PAID=0
# Crawl4AI stealth for review counts; 0 turns it off
SCOUT_CRAWL_STEALTH=1
SCOUT_UNBLOCK_DAILY_CREDITS=1000
